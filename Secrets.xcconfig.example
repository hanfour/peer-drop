// Secrets.xcconfig.example — Copy to Secrets.xcconfig and fill in real values.
// Secrets.xcconfig is gitignored and will not be committed.

// Operator/dev credential (worker `API_KEY`). Bound to the iOS target's
// Debug configuration only — Release iOS builds ship no key and rely on
// App Attest.
PEERDROP_WORKER_API_KEY = YOUR_API_KEY_HERE

// Client credential for the shipped macOS app (worker `MAC_CLIENT_KEY`).
// Native macOS has no App Attest, so the Mac target binds this for Debug
// AND Release. It is deliberately a DIFFERENT secret from the operator key
// above: on the worker it only reaches the relay routes plus the
// read/registration half of /v3, never the account-mutating ones.
PEERDROP_MAC_CLIENT_KEY = YOUR_MAC_CLIENT_KEY_HERE
