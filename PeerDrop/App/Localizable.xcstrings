    "Compare the fingerprint when pairing with another device to confirm a secure channel.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他のデバイスとペアリングする際に、フィンガープリントを照合して安全な接続を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 기기와 페어링할 때 지문을 비교하여 보안 채널을 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与其他设备配对时请比对指纹以确认安全连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與其他裝置配對時請比對指紋以確認安全連線。"
          }
        }
      }
    },
    "Use the Cloudflare Worker relay when devices can't reach each other on the same network.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイス同士が同じネットワーク内で接続できない場合、Cloudflare Worker Relay を使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기들이 같은 네트워크에서 서로 연결할 수 없을 때 Cloudflare Worker Relay를 사용합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当设备无法在同一网络上互相连接时,改用 Cloudflare Worker Relay。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當裝置無法在同一網路上互相連線時,改用 Cloudflare Worker Relay。"
          }
        }
      }
    },
    "Leave blank to use the bundled default. Restart the app after changing.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空欄のままにすると組み込みのデフォルトを使用します。変更後は App を再起動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비워두면 기본값을 사용합니다. 변경 후 App을 다시 시작하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "留空使用内置默认值。修改后请重新启动 App。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "留空使用內建預設值。修改後請重新啟動 App。"
          }
        }
      }
    },
