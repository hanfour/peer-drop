    "Accept & Trust": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accept & Trust"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "受け入れて信頼する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수락 및 신뢰"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接受并信任"
          }
        },
        "zh-Hant": {
