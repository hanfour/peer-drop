<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hard requirement for Mac App Store -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- Pivot 2026-09: same iCloud container as iOS (iCloud.com.hanfour.peerdrop).
         Kept for ONE release so LegacyPetDataCleanup can purge the pet data earlier
         versions stored in iCloud Documents + Key-Value storage. Remove in
         sub-project 1 (docs/superpowers/specs/2026-09-14-notes-diary-pivot-design.md). -->
    <key>com.apple.developer.icloud-container-identifiers</key>
    <array>
        <string>iCloud.com.hanfour.peerdrop</string>
    </array>
    <key>com.apple.developer.ubiquity-kvstore-identifier</key>
    <string>$(TeamIdentifierPrefix)com.hanfour.peerdrop</string>
    <!-- Networking: outbound for relay + worker, incoming for Bonjour discovery -->
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>
    <!-- File access: user-selected drops + Open dialog -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <!-- For inbox + history caches -->
    <key>com.apple.security.files.downloads.read-write</key>
    <true/>
    <!-- BLE peer discovery. macOS App Sandbox uses com.apple.security.device.bluetooth
         (the iOS key com.apple.security.bluetooth is rejected by Mac App Store
         validation: "not supported on macOS"). -->
    <key>com.apple.security.device.bluetooth</key>
    <true/>
    <!-- mDNS / Bonjour discovery over local Wi-Fi. On macOS this is handled by
         the sandbox network client/server entitlements above + the Info.plist
         Bonjour service declarations + the macOS 15 runtime local-network
         permission. The approval-gated com.apple.developer.networking.multicast
         entitlement is iOS/tvOS-only; including it blocked Mac App Store signing
         (a provisioning profile can't embed it until Apple fully approves the
         capability request, and "Assigned" status is not yet profile-ready).
         Intentionally omitted here — re-add only if a future macOS requires it. -->
    <!-- M3: APNs push for voice-call wake. macOS App Sandbox REQUIRES the
         com.apple.developer.aps-environment key. The bare iOS "aps-environment"
         key is unknown on macOS: the signer silently strips it, so the shipped
         build ends up with NO push entitlement and can't register for remote
         notifications at all (didFailToRegisterForRemoteNotifications fires).
         Value mirrors iOS (development in source); the Mac App Store
         distribution profile promotes it to production at export, exactly as
         iOS does — there is no xcconfig "flip" mechanism (that earlier comment
         was wrong). REQUIRES the Push Notifications capability enabled on the
         Mac App ID (6793812911) plus a regenerated Mac provisioning profile,
         otherwise this entitlement is stripped again at signing. See
         docs/release/release-runbook.md §Mac. -->
    <key>com.apple.developer.aps-environment</key>
    <string>development</string>
    <!-- M3: microphone access for WebRTC voice capture.
         NSMicrophoneUsageDescription lives in Info.plist; sandboxed apps
         additionally need this entitlement. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- Keychain access group — mirrors iOS PeerDrop.entitlements. The
         shared crypto stores (IdentityKeyManager / PreKeyStore /
         ChatDataEncryptor / TrustedContactStore) write to the keychain
         with this access group; without it, keychain writes on the Mac
         return errSecMissingEntitlement and the persisted identity from
         the CLI's DP-keychain migration can't survive. Single shared
         group; the app-identifier prefix resolves at signing time. -->
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)com.hanfour.peerdrop</string>
    </array>
</dict>
</plist>
